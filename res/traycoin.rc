#include <winver.h>

1 24 "traycoin.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "hoangquocvietbro\0"
            VALUE "FileDescription",  "TrayCoin - Taskbar & Widget Crypto Tracker\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "TrayCoin\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 hoangquocvietbro (modifications); Based on TraySense, Copyright (C) 2026 DMTWEAKS. Licensed under GNU AGPL-3.0.\0"
            VALUE "OriginalFilename", "TrayCoin.exe\0"
            VALUE "ProductName",      "TrayCoin - Taskbar & Widget Crypto Tracker\0"
            VALUE "ProductVersion",   "2.0.0\0"
            VALUE "Comments",         "Modified from TraySense by @hoangquocvietbro (2026). Licensed under GNU AGPL-3.0.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
